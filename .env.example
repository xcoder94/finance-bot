# Chontak — environment for docker-compose.yml (deployment via Coolify).
# Copy to .env for a local compose run; in Coolify set the same keys in the
# resource's Environment Variables. Never commit a filled-in .env.
#
# PostgreSQL is not part of this stack — it is an external resource.

# ── Required ────────────────────────────────────────────────────────────────

# Async SQLAlchemy URL of the external PostgreSQL.
# The host must be resolvable from inside the stack's docker network
# (a service/resource name, not localhost).
DATABASE_URL=postgresql+asyncpg://chontak:CHANGE_ME@postgres:5432/chontak

# Telegram bot token from @BotFather.
BOT_TOKEN=0000000000:CHANGE_ME

# Secret used to sign app passes. Any long random string; changing it
# invalidates every pass already issued.
APP_PASS_SECRET=CHANGE_ME

# Public https URL of the mini app — the domain attached to the `web` service.
MINI_APP_URL=https://app.example.com

# ── Optional: API ───────────────────────────────────────────────────────────

# Comma-separated origins allowed to call the API.
# Empty = MINI_APP_URL alone.
CORS_ALLOWED_ORIGINS=

# Per-IP request limit applied to every route.
RATE_LIMIT_DEFAULT=120/minute

# Port the API listens on inside the container.
API_PORT=5001

# Gunicorn worker count. Rule of thumb: 2 x CPU cores + 1.
WEB_CONCURRENCY=4

# Log file path inside the container. Logs also go to stdout.
LOG_FILE_PATH=/app/logs/app.log

# ── Optional: bot ───────────────────────────────────────────────────────────

# Telegram chat id that receives support messages. Empty = relay disabled.
SUPPORT_CHAT_ID=

# ── Optional: message parsing ───────────────────────────────────────────────

# Parsing is inactive while PARSER_API_KEY is empty.
# PARSER_PROVIDER: openai | anthropic | google.
# Voice and receipt photos work with google only.
PARSER_PROVIDER=
PARSER_API_KEY=
PARSER_MODEL=

# Per-budget daily caps.
DAILY_MODEL_CALL_LIMIT=50
DAILY_UNPARSED_LIMIT=20

# Receipt photo entry: 1 | true | yes | on to enable. Empty = disabled.
RECEIPT_PHOTO_ENABLED=

# ── Optional: mini app ──────────────────────────────────────────────────────

# Where nginx forwards /api/. Defaults to the `api` service of this stack —
# only set it if the backend lives outside this compose file. No trailing slash.
BACKEND_URL=
