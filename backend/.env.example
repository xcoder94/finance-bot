BOT_TOKEN=your_telegram_bot_token_here
APP_PASS_SECRET=replace-with-long-random-string
DATABASE_URL=postgresql+asyncpg://finance:finance@localhost:5432/finance_bot
POSTGRES_USER=finance
POSTGRES_PASSWORD=finance
POSTGRES_DB=finance_bot
MINI_APP_URL=https://your-tunnel-url.trycloudflare.com

# Quick entry parser (optional until parser is wired)
PARSER_PROVIDER=
PARSER_API_KEY=
PARSER_MODEL=
DAILY_MODEL_CALL_LIMIT=50
DAILY_UNPARSED_LIMIT=20

# Comma-separated list of origins allowed to call the API (CORS).
# Defaults to MINI_APP_URL alone if left empty.
CORS_ALLOWED_ORIGINS=

# Per-IP request limit for all API routes, e.g. "120/minute".
RATE_LIMIT_DEFAULT=120/minute

# Host port the compose postgres is published on (keep DATABASE_URL in sync).
POSTGRES_PORT=5432

# Dev/tests only: set to 1 to skip the Telegram getMe call at API startup.
SKIP_BOT_INIT=

# Comma-separated Telegram IDs allowed to open the admin panel. Empty = no admins.
ADMIN_TELEGRAM_IDS=

# Admin panel: AI cost accounting, USD per 1M tokens as billed by the provider.
# Empty/0 = that part is counted as 0 (admin panel shows $0 cost).
AI_PRICE_INPUT_USD_PER_1M=
AI_PRICE_OUTPUT_USD_PER_1M=
# Optional: audio input tokens, if billed differently.
AI_PRICE_AUDIO_INPUT_USD_PER_1M=
# Daily AI spend (USD, Tashkent day) that sends one alert to every admin. Empty/0 = off.
ADMIN_AI_DAILY_COST_ALERT_USD=
# Retention in days (nightly purge). Defaults: 400 / 730 / 730.
ADMIN_ACTIVITY_RETENTION_DAYS=400
ADMIN_AI_USAGE_RETENTION_DAYS=730
ADMIN_AI_ALERTS_RETENTION_DAYS=730
