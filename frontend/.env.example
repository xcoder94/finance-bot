# Dev-server port for `npm run dev` (Vite). Defaults to 5002 if unset.
VITE_DEV_PORT=5002

# Where the /api proxy forwards to during local dev. Defaults to
# http://127.0.0.1:5001 (the backend's local dev port) if unset.
VITE_PROXY_TARGET=http://127.0.0.1:5001

# Comma-separated list of hosts the dev server accepts requests for
# (Vite's server.allowedHosts). Defaults to .trycloudflare.com if unset.
VITE_ALLOWED_HOSTS=.trycloudflare.com
